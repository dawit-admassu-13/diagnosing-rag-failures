# Copy this file to .env and fill in real values.
# Never commit .env — it is meant to stay local.

# Native Anthropic API (used only if CLAUDE_BASE_URL below is left unset).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Claude Sonnet 4.6 host. Leave CLAUDE_BASE_URL unset to call Anthropic's own
# API directly with ANTHROPIC_API_KEY above. Set both CLAUDE_BASE_URL and
# CLAUDE_API_KEY to instead call Claude through any OpenAI-compatible
# pass-through host (e.g. OpenRouter) — see README "Claude host setup".
# IMPORTANT: model_id in config/experiment.yaml must match whichever host is
# active (native Anthropic model-ids and pass-through slugs differ).
CLAUDE_BASE_URL=
CLAUDE_API_KEY=

# Llama 3.3 70B Instruct host. Any OpenAI-compatible chat-completions
# endpoint works with models/llama_adapter.py. Recommended low-cost
# default below is Deepinfra — see README "Llama host setup" for
# Together/Groq/Fireworks alternatives and their base URLs.
LLAMA_BASE_URL=https://api.deepinfra.com/v1/openai
LLAMA_API_KEY=
